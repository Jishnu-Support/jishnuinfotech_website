# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# PostgreSQL Database Connection URL (Prisma)
# Example for local PostgreSQL: postgresql://postgres:password@localhost:5432/jishnu_infotech_db?schema=public
# Example for Neon/Supabase/Render: postgres://user:password@ep-cool-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/jishnu_infotech?schema=public"

# Admin Authentication
JWT_SECRET="jishnu_infotech_super_secret_jwt_key_2026_!@#$%^"
JWT_EXPIRES_IN="7d"

# Default Admin Seed Credentials
ADMIN_EMAIL="admin@jishnuinfotech.com"
ADMIN_PASSWORD="admin123Password!"
ADMIN_NAME="Jishnu Administrator"

# Email / Nodemailer Configuration (optional for notifications)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="notifications@jishnuinfotech.com"
SMTP_PASS="your-app-password"
NOTIFICATION_EMAIL="contact@jishnuinfotech.com"
